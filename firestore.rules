rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // Community Questions & Discussions (Open submission, public spam reporting, admin deletion)
    match /questions/{questionId} {
      allow read, create, update, delete: if true;

      // Comments subcollection
      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    // Monthly Salah counter for individual users
    match /users/{userId}/salahMonthly/{monthKey} {
      allow read, write: if true;
    }

    // Printable Charts & Posters (Public read, admin write)
    match /printable_charts/{chartId} {
      allow read, write: if true;
    }

    // Notes & Study Guides (Public read, admin write)
    match /notes/{noteId} {
      allow read, write: if true;
    }

    // Email Verifications (optional fallback)
    match /email_verifications/{verificationId} {
      allow read, write: if true;
    }

    // Board Curriculum Study Notes (Admin managed, public read)
    match /board_study_notes/{noteId} {
      allow read, write: if true;
    }

    // Site Visit Counter & Analytics
    match /analytics/{docId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
