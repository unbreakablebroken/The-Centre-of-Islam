rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // Community Questions
    match /questions/{questionId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }
    }

    // Monthly Salah counter for individual users
    match /users/{userId}/salahMonthly/{monthKey} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Printable Charts & Posters (Admin managed, public read)
    match /printable_charts/{chartId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Notes & Study Guides (Public read, authenticated write)
    match /notes/{noteId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Email Verifications (for login and signup codes)
    match /email_verifications/{verificationId} {
      allow read, write: if true;
    }

    // Board Curriculum Study Notes (Admin managed, public read - kept for backwards compatibility)
    match /board_study_notes/{noteId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
